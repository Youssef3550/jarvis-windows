# Hassan for Windows settings. Lines starting with # are ignored.

# What Hassan calls you by name (he says "sir" either way).
USER_NAME=

# Claude model for conversation and for builds: sonnet, opus or haiku.
JARVIS_BRAIN_MODEL=sonnet
JARVIS_BUILD_MODEL=sonnet

# Voices (free Microsoft neural voices). List them all with:
#   .venv\Scripts\edge-tts --list-voices
VOICE_EN=en-GB-RyanNeural
VOICE_NL=nl-BE-ArnaudNeural
VOICE_RATE=+4%

# English voice: local Coqui TTS (free, offline). TTS_ENGINE=edge brings back the Microsoft voice.
TTS_ENGINE=coqui
COQUI_MODEL=tts_models/en/vctk/vits
# p273 or p330 sound British male. Any VCTK speaker (p225 ... p376) works.
COQUI_SPEAKER=p273
# Voice cloning (later): COQUI_MODEL=tts_models/multilingual/multi-dataset/xtts_v2,
# COQUI_TOS_AGREED=1, and the path to a clean 6-30 second WAV of the voice:
# COQUI_SPEAKER_WAV=C:\Users\you\voice.wav
# Folder with espeak-ng.exe, only if it is not in the default place:
# ESPEAK_DIR=C:\Program Files\eSpeak NG

# New projects go here.
PROJECTS_DIR=~/JarvisProjects

# Port for the local web page (http://localhost:8340).
JARVIS_PORT=8340

# Only if Hassan can't find Claude Code: full path to claude.exe or claude.cmd
# CLAUDE_PATH=C:\Users\you\.local\bin\claude.exe
